---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Dekoder Interlinearny — Metoda Birkenbihl" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ucz się angielskiego metodą dekodowania interlinearnego Very Birkenbihl." />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
