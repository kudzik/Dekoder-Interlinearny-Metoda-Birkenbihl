---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout>
  <header class="sticky top-0 z-10 border-b border-stone-200 bg-[#FAF9F6]/95 px-4 py-3 backdrop-blur dark:border-slate-700 dark:bg-slate-900/95">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-xl font-bold tracking-tight">Dekoder Interlinearny</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300">Metoda Birkenbihl — angielski słowo po słowie</p>
      </div>
      <div class="flex gap-2">
        <button id="guide-toggle" class="rounded-lg border px-3 py-2 text-sm">Jak się uczyć?</button>
        <button id="theme-toggle" class="rounded-lg border px-3 py-2 text-sm" aria-label="Zmień motyw">Motyw</button>
      </div>
    </div>
    <aside id="guide-panel" class="mx-auto mt-3 hidden max-w-6xl rounded-lg bg-amber-50 p-3 text-sm dark:bg-slate-800">
      Najpierw czytaj dosłowne glosy nad angielskimi słowami, potem słuchaj tekstu i sprawdź się w trybie testu.
    </aside>
  </header>

  <main class="mx-auto max-w-6xl space-y-5 px-4 py-6">
    <section class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-semibold">1. Wczytaj Markdown lub wklej tekst</h2>
        <div class="flex gap-2">
          <button id="load-example" class="rounded-lg bg-stone-100 px-3 py-1.5 text-sm dark:bg-slate-800">Załaduj przykład</button>
          <button id="clear-input" class="rounded-lg px-3 py-1.5 text-sm">Wyczyść</button>
        </div>
      </div>
      <div class="grid gap-3 lg:grid-cols-3">
        <label id="dropzone" class="flex min-h-32 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-stone-300 p-4 text-center text-sm hover:border-teal-600 dark:border-slate-600">
          <span>Upuść plik .md/.txt lub kliknij, aby wybrać</span>
          <span id="file-name" class="mt-1 text-xs text-slate-500">Zachowujemy nagłówki, akapity i listy</span>
          <input id="file-input" type="file" accept=".md,.markdown,.txt,text/markdown,text/plain" class="sr-only" />
        </label>
        <textarea id="markdown-input" rows="6" class="rounded-xl border border-stone-300 bg-[#FAF9F6] p-3 font-mono text-sm dark:border-slate-600 dark:bg-slate-950 lg:col-span-2" placeholder="Wklej angielski tekst w Markdown..."></textarea>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-stone-100 pt-3 dark:border-slate-700">
        <p class="max-w-2xl text-xs text-slate-600 dark:text-slate-300">Tekst zostanie wysłany do Gemini w celu dekodowania. Nie wklejaj treści poufnych.</p>
        <button id="decode-button" class="rounded-xl bg-teal-700 px-5 py-2.5 font-semibold text-white hover:bg-teal-800 disabled:opacity-60">Dekoduj tekst (AI)</button>
      </div>
      <p id="status-message" role="status" aria-live="polite" class="mt-3 text-sm"></p>
    </section>

    <section id="workspace" class="hidden space-y-4">
      <div class="flex flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Tryb nauki">
          <button class="mode-button rounded-lg bg-teal-100 px-3 py-2 text-sm text-teal-900" data-mode="decode">Dekodowanie</button>
          <button class="mode-button rounded-lg px-3 py-2 text-sm" data-mode="listen">Aktywne słuchanie</button>
          <button class="mode-button rounded-lg px-3 py-2 text-sm" data-mode="test">Test / Active Recall</button>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <label class="flex items-center gap-2 text-sm">Głos
            <select id="voice-select" class="max-w-48 rounded border bg-white p-1.5 text-sm dark:bg-slate-800" aria-label="Wybierz głos"></select>
          </label>
          <label class="flex items-center gap-2 text-sm">Tempo
            <select id="rate-select" class="rounded border bg-white p-1.5 text-sm dark:bg-slate-800" aria-label="Prędkość czytania">
              <option value="0.6">0.6x</option>
              <option value="0.8">0.8x</option>
              <option value="1" selected>1.0x</option>
              <option value="1.2">1.2x</option>
            </select>
          </label>
          <button id="play-all" class="rounded-lg bg-teal-100 px-3 py-2 text-sm text-teal-900">Czytaj całość</button>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <label class="flex items-center gap-2 text-sm">
          <input id="show-natural" type="checkbox" />
          Pokaż naturalne tłumaczenie zdań
        </label>
        <span id="test-counter" class="text-sm text-slate-600 dark:text-slate-300"></span>
        <div class="flex gap-2">
          <button id="export-md" class="rounded-lg border px-3 py-2 text-sm">Eksport Markdown</button>
          <button id="export-html" class="rounded-lg border px-3 py-2 text-sm">Eksport HTML offline</button>
        </div>
      </div>
      <article id="reader" class="space-y-5 rounded-2xl border border-stone-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900" aria-label="Zdekodowany tekst"></article>
    </section>
  </main>

  <aside id="grammar-popover" hidden class="fixed z-20 max-w-xs rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white shadow-xl" role="status"></aside>

  <footer class="border-t border-stone-200 px-4 py-5 text-center text-xs text-slate-500 dark:border-slate-700">
    Kliknij słowo lub zbitkę, aby usłyszeć wymowę i zobaczyć glosę gramatyczną.
  </footer>
</AppLayout>

<script>
  import { initializeApp } from "../scripts/app";

  initializeApp();
</script>
