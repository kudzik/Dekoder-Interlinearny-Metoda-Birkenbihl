{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dekoder-interlinearny-birkenbihl",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "DECODE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
